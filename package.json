{
  "name": "vscode-tmux-worktree",
  "displayName": "TMUX Worktree",
  "description": "Manage tmux sessions with git worktrees",
  "version": "1.2.19",
  "engines": {
    "vscode": "^1.85.0"
  },
  "publisher": "kargnas",
  "license": "MIT",
  "icon": "resources/icon.png",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "tmux",
    "worktree",
    "git",
    "git-worktree",
    "terminal",
    "session",
    "branch",
    "workflow",
    "ai-coding",
    "vibe-coding",
    "claude-code",
    "codex",
    "opencode",
    "parallel-development",
    "multi-branch",
    "coding-agent",
    "remote-ssh"
  ],
  "galleryBanner": {
    "color": "#1BB352",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/kargnas.vscode-tmux-worktree",
      "href": "https://marketplace.visualstudio.com/items?itemName=kargnas.vscode-tmux-worktree",
      "description": "VS Marketplace Version"
    }
  ],
  "homepage": "https://github.com/kargnas/vscode-ext-tmux-worktree",
  "bugs": {
    "url": "https://github.com/kargnas/vscode-ext-tmux-worktree/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kargnas/vscode-ext-tmux-worktree.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tmux-explorer",
          "title": "TMUX",
          "icon": "resources/tmux.svg"
        }
      ]
    },
    "views": {
      "tmux-explorer": [
        {
          "id": "tmuxSessions",
          "name": "TMUX Worktrees"
        }
      ]
    },
    "commands": [
      {
        "command": "tmux.attachCreate",
        "title": "TMUX: Attach/Create Session"
      },
      {
        "command": "tmux.newTask",
        "title": "TMUX: New Task"
      },
      {
        "command": "tmux.removeTask",
        "title": "TMUX: Remove Task"
      },
      {
        "command": "tmux.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "tmux.filter",
        "title": "Filter Sessions",
        "icon": "$(filter)"
      },
      {
        "command": "tmux.attach",
        "title": "Attach in Terminal"
      },
      {
        "command": "tmux.attachInEditor",
        "title": "Attach in Editor"
      },
      {
        "command": "tmux.openWorktree",
        "title": "Open Worktree in New Window"
      },
      {
        "command": "tmux.copyPath",
        "title": "Copy Worktree Path"
      },
      {
        "command": "tmux.newPane",
        "title": "New Pane (Split)"
      },
      {
        "command": "tmux.newWindow",
        "title": "New Window"
      },
      {
        "command": "tmux.cleanupOrphans",
        "title": "TMUX: Cleanup Orphans",
        "icon": "$(trash)"
      },
      {
        "command": "tmux.terminalPaste",
        "title": "TMUX: Smart Paste (Image Support)"
      },
      {
        "command": "tmux.pasteImage",
        "title": "TMUX: Paste Image from Clipboard"
      },
      {
        "command": "tmux.createWorktreeFromBranch",
        "title": "Create Worktree from This Branch"
      },
      {
        "command": "tmux.switchBackend",
        "title": "Switch Backend",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "tmux.changeSocketDir",
        "title": "TMUX: Change Session File Directory"
      },
      {
        "command": "tmux.syncSocketDirToShell",
        "title": "TMUX: Sync Session File Directory to Shell rc"
      }
    ],
    "keybindings": [
      {
        "command": "tmux.terminalPaste",
        "key": "cmd+v",
        "when": "terminalFocus",
        "mac": "cmd+v",
        "linux": "ctrl+shift+v"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+[Enter]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b[13;2u"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+[ArrowLeft]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b[1;2D"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+[ArrowRight]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b[1;2C"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "ctrl+[KeyD]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u0004"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "ctrl+[KeyQ]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u0011"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "ctrl+[KeyG]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u0007"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyF]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bf"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyN]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bn"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyI]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bi"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyO]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bo"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyH]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bh"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyJ]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bj"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyK]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bk"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyL]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bl"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[ArrowLeft]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b[1;3D"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[ArrowRight]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b[1;3C"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[ArrowDown]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b[1;3B"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[ArrowUp]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b[1;3A"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[Equal]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b="
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[Minus]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b-"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[BracketLeft]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b["
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[BracketRight]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001b]"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+[KeyP]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bp"
        }
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+shift+[KeyP]",
        "when": "terminalFocus && config.tmuxWorktree.multiplexer == 'zellij'",
        "args": {
          "text": "\u001bP"
        }
      }
    ],
    "configuration": {
      "title": "TMUX Worktree",
      "properties": {
        "tmuxWorktree.multiplexer": {
          "type": "string",
          "enum": [
            "tmux",
            "zellij"
          ],
          "default": "tmux",
          "markdownDescription": "Terminal multiplexer backend to use (`tmux` or `zellij`). Changes apply immediately."
        },
        "tmuxWorktree.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the base branch used when creating new task worktrees (e.g. `master`, `origin/master`). Leave empty to auto-detect from `origin/main`, `main`, `origin/master`, `master`."
        },
        "tmuxWorktree.socketDir": {
          "type": "string",
          "default": "/var/tmp",
          "markdownDescription": "Directory for tmux/zellij session files (sockets). Zellij uses `${socketDir}/zellij/<session>`. Tmux is launched with `TMUX_TMPDIR=${socketDir}` so its sockets land in `${socketDir}/tmux-<UID>/`. `~` is expanded. Restart attached sessions to fully apply."
        },
        "tmuxWorktree.socketDirInitialized": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Internal flag — set to `true` after the first-activation prompt completes. Reset to `false` to re-prompt on next activation."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "tmux.switchBackend",
          "when": "view == tmuxSessions",
          "group": "navigation"
        },
        {
          "command": "tmux.refresh",
          "when": "view == tmuxSessions",
          "group": "navigation"
        },
        {
          "command": "tmux.newTask",
          "when": "view == tmuxSessions",
          "group": "navigation",
          "icon": "$(plus)"
        },
        {
          "command": "tmux.filter",
          "when": "view == tmuxSessions",
          "group": "navigation"
        },
        {
          "command": "tmux.cleanupOrphans",
          "when": "view == tmuxSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tmux.attach",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "1_attach"
        },
        {
          "command": "tmux.attachInEditor",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "1_attach"
        },
        {
          "command": "tmux.openWorktree",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "2_open"
        },
        {
          "command": "tmux.copyPath",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "2_open"
        },
        {
          "command": "tmux.newPane",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "3_tmux"
        },
        {
          "command": "tmux.newWindow",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "3_tmux"
        },
        {
          "command": "tmux.createWorktreeFromBranch",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "4_create"
        },
        {
          "command": "tmux.removeTask",
          "when": "view == tmuxSessions && viewItem == tmuxItem",
          "group": "5_danger"
        }
      ]
    }
  },
  "activationEvents": [
    "onView:tmuxSessions"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "generate:zellij-keybindings": "node scripts/generate-zellij-keybindings.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "typescript": "^5.3.0"
  }
}
